# Configurações do Banco de Dados
DATABASE_URL=postgresql://postgres:password@localhost:5432/app_autonomo

# Configurações de Segurança
SECRET_KEY=your-secret-key-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Redis (para Celery)
REDIS_URL=redis://localhost:6379/0

# Certificado Digital
CERTIFICATE_PATH=/path/to/certificate.pfx
CERTIFICATE_PASSWORD=certificate-password

# Configurações de API de Pagamento (Pix)
PIX_API_KEY=your-pix-api-key
PIX_API_URL=https://api.example.com/pix

# Configurações de API de Nota Fiscal
NF_API_KEY=your-nf-api-key
NF_API_URL=https://api.example.com/nf

# Configurações de CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:19006,exp://192.168.1.100:19000

# Modo de Ambiente (development, production)
ENVIRONMENT=development
